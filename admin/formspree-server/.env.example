# Copy to .env on the backend host. Never commit the populated .env file.

# Initial administrator setup. The password is hashed on first server start.
ADMIN_EMAIL=administrator@gmail.com
ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# HTTPS origin of the deployed admin frontend. Comma-separate multiple origins.
ADMIN_ALLOWED_ORIGIN=https://your-site.netlify.app

# Public HTTPS Netlify origin used to build password-reset links.
ADMIN_PUBLIC_URL=https://your-site.netlify.app

# Private JSONBin storage used only by authenticated admin API routes.
JSONBIN_BIN_ID=replace_with_your_jsonbin_bin_id
JSONBIN_MASTER_KEY=replace_with_your_jsonbin_master_key

# Private Formspree API access used by server-side proxy routes.
FORM_ID=replace_with_your_form_id
FORM_TOKEN=replace_with_your_form_token

# Keep false on Render because Netlify serves the frontend.
SERVE_FRONTEND=false

# SMTP password-recovery settings.
# Required: hostname supplied by your email provider, for example smtp.gmail.com.
SMTP_HOST=smtp.gmail.com
# Optional: use 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587
# Optional: set true for port 465; keep false for port 587 STARTTLS.
SMTP_SECURE=false
# Required: SMTP-authenticated mailbox username, normally the full email address.
SMTP_USER=administrator@gmail.com
# Required: SMTP password or provider-issued app password.
SMTP_PASS=replace_with_your_smtp_app_password
# Optional: approved From address, normally the authenticated mailbox.
SMTP_FROM=administrator@gmail.com

# Local/server listen port.
PORT=3000
